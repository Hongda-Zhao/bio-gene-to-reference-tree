{
  "schema_version": "0.2",
  "project_id": "synthetic-review-example",
  "objective": "ortholog-tree",
  "sequence_context": "cellular",
  "query": {
    "kind": "protein-fasta",
    "path": "query.example.faa",
    "id": "QUERY_001",
    "original_value": "QUERY_001",
    "organism": "Homo sapiens",
    "taxon_id": "9606",
    "gene_name": "SYNTHETIC1",
    "protein_name": "Synthetic review protein",
    "source_db": "SyntheticDB",
    "source_release": "2026-08",
    "retrieved_at": "2026-08-06"
  },
  "taxon_scope": {
    "ingroup": "Vertebrata",
    "outgroup": "non-vertebrate Chordata"
  },
  "privacy": {
    "remote_search_allowed": false,
    "unpublished_sequence": false
  },
  "references": {
    "strategy": "ortholog-first",
    "candidate_table": "candidates.example.tsv",
    "candidate_fasta": "candidates.example.faa",
    "discovery_tiers": [
      "curated orthologs",
      "RefSeq protein",
      "Swiss-Prot",
      "UniProtKB/nr",
      "profile/domain"
    ]
  },
  "selection": {
    "min_query_coverage": 0.7,
    "min_target_coverage": 0.7,
    "min_length_ratio": 0.6,
    "max_length_ratio": 1.6,
    "max_per_taxon": 1,
    "max_references": 3,
    "min_ingroup_taxa": 2,
    "require_outgroup": true,
    "outgroup_count": 1,
    "allow_paralogs": false
  },
  "clustering": {
    "mode": "auto",
    "tool": "mmseqs2",
    "trigger_min_sequences": 200,
    "algorithm": "easy-linclust",
    "min_seq_id": 0.95,
    "coverage": 0.8,
    "coverage_mode": 0,
    "threads": 4,
    "preserve_analysis_groups": ["study", "outgroup"]
  },
  "alignment": {
    "tool": "mafft",
    "mode": "auto",
    "threads": 4
  },
  "trimming": {
    "enabled": true,
    "tool": "trimal",
    "primary_profile": "balanced",
    "profiles": [
      {"id": "strict", "gap_threshold": 0.98},
      {"id": "balanced", "gap_threshold": 0.9},
      {"id": "permissive", "gap_threshold": 0.5}
    ],
    "min_retained_fraction": 0.3,
    "compare_topologies": true
  },
  "tree": {
    "mode": "accurate",
    "tool": "iqtree2",
    "model": "MFP",
    "support": {
      "method": "ultrafast",
      "replicates": 1000,
      "sh_alrt": 1000,
      "bnni": true
    },
    "threads": 4,
    "seed": 12345,
    "rooting": "outgroup"
  },
  "itol": {
    "enabled": true,
    "dataset_label": "Sequence roles",
    "colors": {
      "study": "#E69F00",
      "expanded": "#009E73",
      "outgroup": "#999999"
    },
    "generate_ranges_after_tree_qc": false
  },
  "literature": {
    "enabled": true,
    "years_back": 10,
    "include_foundational": true,
    "taxon_fallback_ranks": ["species", "genus", "family", "order"],
    "sources": [
      "primary literature",
      "Open Tree of Life",
      "authoritative taxonomy"
    ]
  }
