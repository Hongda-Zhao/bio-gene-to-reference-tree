{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bio-gene-to-reference-tree:plan:0.3",
  "title": "Gene-to-reference-tree plan 0.3",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "run_id",
    "state",
    "objective",
    "query_resolution",
    "taxonomy_plan",
    "reference_discovery",
    "clustering_plan",
    "alignment_plan",
    "trimming_plan",
    "tree_plan",
    "annotation_plan",
    "literature_plan",
    "decision_gates",
    "planned_commands",
    "plan_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.3"},
    "state": {
      "enum": ["pending-clustering", "blocked", "pending-reference-approval"]
    },
    "plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "taxonomy_plan": {
      "type": "object",
      "required": ["enabled", "status", "source", "match_mode"],
      "properties": {
        "enabled": {"type": "boolean"},
        "status": {"enum": ["not-requested", "validated"]},
        "source": {"const": "ncbi-taxdump"},
        "match_mode": {"const": "exact-scientific-name"},
        "snapshot": {"type": "string", "minLength": 1},
        "source_url": {
          "type": "string",
          "pattern": "^https://ftp\\.ncbi\\.nlm\\.nih\\.gov/pub/taxonomy/(?:new_taxdump/new_taxdump\\.(?:tar\\.gz|zip)|taxdump_archive/new_taxdump_[0-9]{4}-[0-9]{2}-[0-9]{2}\\.zip)$"
        },
        "retrieved_at": {
          "type": "string",
          "oneOf": [
            {"pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
            }
          ]
        },
        "names_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "nodes_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "records_validated": {"type": "integer", "minimum": 1},
        "resolver_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "resolution_artifact": {"const": "taxonomy_resolution.tsv"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
          "then": {
            "properties": {"status": {"const": "validated"}},
            "required": [
              "snapshot",
              "source_url",
              "retrieved_at",
              "names_sha256",
              "nodes_sha256",
              "records_validated",
              "resolver_version",
              "resolution_artifact"
            ]
          },
          "else": {"properties": {"status": {"const": "not-requested"}}}
        }
      ]
    },
    "decision_gates": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "object", "required": ["id", "status", "requires"]}
    },
    "planned_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stage", "tool", "argv", "status", "executed"],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "executed": {"const": false}
        }
      }
    }
  }
}
